<resources>

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.
    -->
    <style name="AppBaseTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
        -->
        <item name="android:imageButtonStyle">@style/image_button</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Open Camera UI Fork: material dark, dense lists (settings screens and dialogs) -->
        <item name="colorAccent">@color/uifork_accent</item>
        <item name="android:colorAccent">@color/uifork_accent</item>
        <item name="android:colorBackground">@color/uifork_surface</item>
        <item name="android:listPreferredItemHeightSmall">44dp</item>
        <item name="android:listPreferredItemHeight">52dp</item>
        <item name="android:listPreferredItemPaddingStart">18dp</item>
        <item name="android:listPreferredItemPaddingEnd">18dp</item>
        <item name="android:listPreferredItemPaddingLeft">18dp</item>
        <item name="android:listPreferredItemPaddingRight">18dp</item>
        <item name="android:textAppearanceListItem">@style/UiForkListItem</item>
        <item name="android:textAppearanceListItemSecondary">@style/UiForkListItemSecondary</item>
        <item name="android:textAppearanceListItemSmall">@style/UiForkListItem</item>
    </style>

    <style name="UiForkListItem" parent="@android:style/TextAppearance.Material.Subhead">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="UiForkListItemSecondary" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>

    <style name="image_button" parent="@android:style/Widget.Material.ImageButton">
        <item name="android:backgroundTint">#d05a595b</item> <!-- standard material design backgroundTint is #ff5a595b, but we want transparent image buttons -->
    </style>
</resources>
