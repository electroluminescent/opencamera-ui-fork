<?xml version="1.0" encoding="utf-8"?>
<!-- Open Camera UI Fork: white ring with red record dot -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
            <size android:width="80dp" android:height="80dp" />
        </shape>
    </item>
    <item android:left="11dp" android:top="11dp" android:right="11dp" android:bottom="11dp">
        <shape android:shape="oval">
            <solid android:color="#FFE53935" />
        </shape>
    </item>
</layer-list>
