<?xml version="1.0" encoding="utf-8"?>
<!-- Open Camera UI Fork: white ring with red stop square -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
            <size android:width="80dp" android:height="80dp" />
        </shape>
    </item>
    <item android:left="26dp" android:top="26dp" android:right="26dp" android:bottom="26dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFE53935" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
